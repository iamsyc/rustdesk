+#if TARGET_OS_OSX
+static CGColorSpaceRef vt_decoder_colorspace(CFDictionaryRef attachments,
+                                             const AVFrame *src)
+{
+    AVHWFramesContext *frames = (AVHWFramesContext *)src->hw_frames_ctx->data;
+    VTFramesContext *fctx = frames->hwctx;
+    const CFStringRef keys[] = {
+        kCVImageBufferICCProfileKey, kCVImageBufferColorPrimariesKey,
+        kCVImageBufferTransferFunctionKey, kCVImageBufferYCbCrMatrixKey,
+        kCVImageBufferGammaLevelKey,
+    };
+    CFMutableDictionaryRef properties = CFDictionaryCreateMutable(NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CGColorSpaceRef result;
+
+    // These are the documented inputs to Core Video's color-space synthesis.
+    for (int i = 0; i < FF_ARRAY_ELEMS(keys); i++) {
+        CFTypeRef value = CFDictionaryGetValue(attachments, keys[i]);
+        if (value)
+            CFDictionarySetValue(properties, keys[i], value);
+    }
+    os_unfair_lock_lock(&fctx->colorspace_lock);
+    if (fctx->colorspace && fctx->color_properties &&
+        CFEqual(fctx->color_properties, properties)) {
+        result = (CGColorSpaceRef)CFRetain(fctx->colorspace);
+    } else {
+        result = CVImageBufferCreateColorSpaceFromAttachments(attachments);
+        if (fctx->color_properties)
+            CFRelease(fctx->color_properties);
+        if (fctx->colorspace)
+            CFRelease(fctx->colorspace);
+        fctx->color_properties = CFPropertyListCreateDeepCopy(NULL, properties,
+                                                             kCFPropertyListImmutable);
+        fctx->colorspace = result ? (CGColorSpaceRef)CFRetain(result) : NULL;
+    }
+    os_unfair_lock_unlock(&fctx->colorspace_lock);
+    CFRelease(properties);
+    return result;
+}
+#endif
