-            colorspace =
-                CVImageBufferCreateColorSpaceFromAttachments(attachments);
+#if TARGET_OS_OSX
+            if (src->format == AV_PIX_FMT_VIDEOTOOLBOX && src->hw_frames_ctx)
+                colorspace = vt_decoder_colorspace(attachments, src);
