+TEST_F(FlutterEmbedderExternalTextureTest, NativeNv12PreservesLeftChromaSiting) {
+  if (!MTLCreateSystemDefaultDevice()) {
+    GTEST_SKIP() << "Metal device is unavailable";
+  }
+  FlutterDarwinContextMetalSkia* metal =
+      [[FlutterDarwinContextMetalSkia alloc] initWithDefaultMTLDevice];
+  GrDirectContext* gr = metal.mainContext.get();
+  auto info = SkImageInfo::Make(16, 16, kRGBA_8888_SkColorType, kPremul_SkAlphaType);
+  auto surface = SkSurfaces::RenderTarget(gr, skgpu::Budgeted::kNo, info);
+  ASSERT_NE(surface, nullptr);
+  LeftChromaNv12Texture* provider =
+      [[LeftChromaNv12Texture alloc] initWidth:16
+                                        height:16
+                               pixelFormatType:kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange];
+  FlutterExternalTexture* holder = [[FlutterExternalTexture alloc] initWithFlutterTexture:provider
+                                                                       darwinMetalContext:metal];
+  EmbedderExternalTextureMetal::ExternalTextureCallback callback = [&](int64_t, size_t, size_t) {
+    auto frame = std::make_unique<FlutterMetalExternalTexture>();
+    EXPECT_TRUE([holder populateTexture:frame.get()]);
+    EXPECT_TRUE(frame->chroma_cosited_x);
+    return frame;
+  };
+  std::unique_ptr<flutter::Texture> texture =
+      std::make_unique<EmbedderExternalTextureMetal>(1, callback);
+  DlSkCanvasAdapter canvas(surface->getCanvas());
+  flutter::Texture::PaintContext context{.canvas = &canvas, .gr_context = gr};
+  texture->Paint(context, SkRect::MakeWH(16, 16), false, DlImageSampling::kNearestNeighbor);
+  gr->flushAndSubmit(GrSyncCpu::kYes);
+  uint8_t pixels[16 * 16 * 4] = {};
+  ASSERT_TRUE(surface->readPixels(info, pixels, 16 * 4, 0, 0));
+  for (size_t row = 0; row < 16; ++row) {
+    for (size_t col = 0; col < 16; ++col) {
+      const double u = std::min(80.0 + col * 4.0, 136.0) - 128.0;
+      const double luma = (128.0 - 16.0) * 255.0 / 219.0;
+      EXPECT_NEAR(pixels[(row * 16 + col) * 4], std::lround(luma), 3);
+      EXPECT_NEAR(pixels[(row * 16 + col) * 4 + 1], std::lround(luma - 0.39176229 * u), 3);
+      EXPECT_NEAR(pixels[(row * 16 + col) * 4 + 2], std::lround(luma + 2.01723214 * u), 3);
+      EXPECT_EQ(pixels[(row * 16 + col) * 4 + 3], 255u);
+    }
+  }
+}
+
 }  // namespace flutter::testing
