+      bytesPerRow:256];
+  auto info = SkImageInfo::Make(256, 256, kRGBA_8888_SkColorType, kOpaque_SkAlphaType);
+  std::vector<uint8_t> results[2] = {std::vector<uint8_t>(256 * 256 * 4),
