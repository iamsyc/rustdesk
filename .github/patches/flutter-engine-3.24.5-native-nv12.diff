+    for (int col = 0; col < 256; col++) {
+      luma[row * 256 + col] = 16 + (row * 13 + col * 7) % 220;
+    }
+  }
+  for (int row = 0; row < 128; row++) {
+    for (int col = 0; col < 128; col++) {
+      chroma[(row * 128 + col) * 2] = 16 + col * 224 / 127;
+      chroma[(row * 128 + col) * 2 + 1] = 16 + row * 224 / 127;
