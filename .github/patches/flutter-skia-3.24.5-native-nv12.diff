+// Core Video's current source profile uses this pure power curve. Specializing
+// the normalized opaque YUV path removes generic transfer-function parameters.
+static std::unique_ptr<GrFragmentProcessor> native_gamma_xform(
+        std::unique_ptr<GrFragmentProcessor> input, const SkColorSpaceXformSteps& steps) {
+    static const SkRuntimeEffect* effect = SkMakeRuntimeEffect(
+        SkRuntimeEffect::MakeForColorFilter, R"(
+        uniform float4 row0;
+        uniform float4 row1;
+        uniform float4 row2;
+        float encode(float x) {
+            float s = sign(x);
+            x = abs(x);
+            return s * (x < 0.0031308 ? 12.92 * x : 1.055 * pow(x, 1.0 / 2.4) - 0.055);
+        }
+        half4 main(half4 color) {
+            float3 x = float3(color.rgb);
+            float3 linear = pow(x, float3(1.9609375));
+            float3 rgb = float3(dot(row0.xyz, linear), dot(row1.xyz, linear),
+                                dot(row2.xyz, linear));
+            return half4(encode(rgb.r), encode(rgb.g), encode(rgb.b), color.a);
+        }
+    )");
+    const float identity[] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+    const float* m = steps.flags.gamut_transform ? steps.src_to_dst_matrix : identity;
+    return GrSkSLFP::Make(effect, "NativeYuvGamma", std::move(input),
+                         GrSkSLFP::OptFlags::kPreservesOpaqueInput,
+                         "row0", SkV4{m[0], m[3], m[6], 0},
+                         "row1", SkV4{m[1], m[4], m[7], 0},
+                         "row2", SkV4{m[2], m[5], m[8], 0});
+}
+#endif
