@@ -334,4 +334,73 @@ - (CVPixelBufferRef)pixelBuffer {
   texture->Paint(context, bounds, /*freeze=*/false, sampling);
 }

+TEST_F(FlutterEmbedderExternalTextureTest, RejectingFrameReleasesResources) {
+  int releases = 0;
+  EmbedderExternalTextureMetal::ExternalTextureCallback callback = [&](int64_t, size_t, size_t) {
+    auto frame = std::make_unique<FlutterMetalExternalTexture>();
+    frame->struct_size = sizeof(FlutterMetalExternalTexture);
+    frame->pixel_format = FlutterMetalExternalTexturePixelFormat::kRGBA;
+    frame->user_data = &releases;
+    frame->destruction_callback = [](void* data) { ++*static_cast<int*>(data); };
+    return frame;
+  };
+  auto surface = SkSurfaces::Raster(SkImageInfo::MakeN32Premul(16, 16));
+  DlSkCanvasAdapter canvas(surface->getCanvas());
+  flutter::Texture::PaintContext context{.canvas = &canvas};
+  std::unique_ptr<flutter::Texture> texture =
+      std::make_unique<EmbedderExternalTextureMetal>(1, callback);
+  texture->Paint(context, SkRect::MakeWH(16, 16), false, DlImageSampling::kNearestNeighbor);
+  EXPECT_EQ(releases, 1);
+  texture.reset();
+  EXPECT_EQ(releases, 1);
+}
+
+TEST_F(FlutterEmbedderExternalTextureTest, FrameResourcesSurvivePendingGPUDraw) {
+  if (!MTLCreateSystemDefaultDevice()) {
+    GTEST_SKIP() << "Metal device is unavailable";
+  }
+  FlutterDarwinContextMetalSkia* metal =
+      [[FlutterDarwinContextMetalSkia alloc] initWithDefaultMTLDevice];
+  GrDirectContext* gr = metal.mainContext.get();
+  auto surface = SkSurfaces::RenderTarget(gr, skgpu::Budgeted::kNo,
+                                         SkImageInfo::MakeN32Premul(16, 16));
+  ASSERT_NE(surface, nullptr);
+  TestExternalTexture* provider =
+      [[TestExternalTexture alloc] initWidth:16 height:16 pixelFormatType:kCVPixelFormatType_32BGRA];
+  FlutterExternalTexture* holder =
+      [[FlutterExternalTexture alloc] initWithFlutterTexture:provider darwinMetalContext:metal];
+  auto releases = std::make_shared<int>(0);
+  struct FrameRelease {
+    VoidCallback callback;
+    void* data;
+    std::shared_ptr<int> releases;
+  };
+  EmbedderExternalTextureMetal::ExternalTextureCallback callback = [&](int64_t, size_t, size_t) {
+    auto frame = std::make_unique<FlutterMetalExternalTexture>();
+    EXPECT_TRUE([holder populateTexture:frame.get()]);
+    EXPECT_NE(frame->destruction_callback, nullptr);
+    if (frame->destruction_callback) {
+      frame->user_data = new FrameRelease{frame->destruction_callback, frame->user_data, releases};
+      frame->destruction_callback = [](void* data) {
+        std::unique_ptr<FrameRelease> owner(static_cast<FrameRelease*>(data));
+        ++*owner->releases;
+        owner->callback(owner->data);
+      };
+    }
+    return frame;
+  };
+  std::unique_ptr<flutter::Texture> texture =
+      std::make_unique<EmbedderExternalTextureMetal>(1, callback);
+  DlSkCanvasAdapter canvas(surface->getCanvas());
+  flutter::Texture::PaintContext context{.canvas = &canvas, .gr_context = gr};
+  texture->Paint(context, SkRect::MakeWH(16, 16), false, DlImageSampling::kNearestNeighbor);
+  texture->MarkNewFrameAvailable();
+  texture.reset();
+  EXPECT_EQ(*releases, 0);
+  gr->flushAndSubmit(GrSyncCpu::kYes);
+  surface.reset();
+  gr->freeGpuResources();
+  EXPECT_EQ(*releases, 1);
+}
+
 }  // namespace flutter::testing
